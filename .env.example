# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — server-only, never expose to the client. Used solely by
# the cron job to read across all users when evaluating alerts.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (email alerts) — resend.com, free tier is plenty for personal use
RESEND_API_KEY=
# Must be on a domain verified in Resend, or use the shared onboarding@resend.dev while testing
ALERT_FROM_EMAIL="Budget <onboarding@resend.dev>"

# Anthropic (AI coaching insights) — console.anthropic.com
ANTHROPIC_API_KEY=

# Random secret shared with Vercel Cron to authorize /api/cron/daily-check.
# Generate with: openssl rand -hex 32
CRON_SECRET=
